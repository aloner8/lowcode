# Dependencies
/node_modules/
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/

# Production and package build output
/build/
/dist/

# Test and coverage output
/coverage/
/.nyc_output/
/playwright-report/
/test-results/

# TypeScript and tool caches
*.tsbuildinfo
.eslintcache
.stylelintcache
.turbo/
.vercel/

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks

# Logs and process files
*.log
*.log.*
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tenant uploads written by the File Manager
/storage/

# Local database data and dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Docker files that contain machine-local overrides
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.*.local.yml
docker-compose.*.local.yaml

# IDE and editor state
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
/.cache/
/tmp/
/temp/
*.tmp

# Local legacy YII reference project and database export.
# This directory is ~745 MB and contains generated assets, a >100 MB archive,
# uploaded content, local configuration, and credentials. Keep it local only.
/public/YII/

