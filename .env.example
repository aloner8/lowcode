# ---------------------------------------------------------------------------
# Copy to .env (docker compose) and/or .env.local (next dev), then fill in.
# Never commit the filled-in file — .gitignore already excludes .env*
# ---------------------------------------------------------------------------

# --- Core control-plane database (REQUIRED) --------------------------------
# Every API route reads this. From the host use localhost:35432; from inside
# the compose network use core-db:5432.
CORE_DATABASE_URL=postgresql://lowcode_admin:lowcode_dev_password@localhost:35432/lowcode_core
CORE_DB_SCHEMA=public

# --- Secrets (REQUIRED) ----------------------------------------------------
# docker compose refuses to start without these, and the app rejects any value
# that has been published in this repository — a shared default protects nothing.
#
# Generate both automatically:   npm run secrets
# Rotate them later:             npm run secrets -- --rotate
# Or by hand:                    openssl rand -base64 48
AUTH_SECRET=
PLATFORM_JWT_SECRET=

# --- Postgres container credentials (docker compose) -----------------------
CORE_POSTGRES_DB=lowcode_core
CORE_POSTGRES_USER=lowcode_admin
CORE_POSTGRES_PASSWORD=lowcode_dev_password

# --- pgAdmin (docker compose) ----------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@lowcode.dev
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password

# --- Platform runtime containers -------------------------------------------
DOCKER_SOCKET_PATH=/var/run/docker.sock
PLATFORM_RUNTIME_BASE_IMAGE=lowcode-app:latest
PLATFORM_RUNTIME_NETWORK=lowcode_network

# --- Multi-site launcher (scripts/run-sites.mjs) ---------------------------
# Interface each site process binds to.
SITES_HOSTNAME=0.0.0.0
# Set automatically per child process — do not set by hand for the studio:
#   SITE_SLUG=<app slug served by this process>
#   SITE_DOMAIN_MAP={"example.go.th":"example"}

# --- Uploads ---------------------------------------------------------------
# Maximum upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
# Root for File Manager uploads, one directory per tenant. In compose this is a
# named volume; set it to a persistent path on bare metal.
TENANT_STORAGE_ROOT=./storage/tenants
